{
  "base": "dark",
  "tokens": {
    "--background": "#24273a",
    "--editor-surface": "#24273a",
    "--foreground": "#cad3f5",
    "--card": "#1e2030",
    "--card-foreground": "#cad3f5",
    "--popover": "#1e2030",
    "--popover-foreground": "#cad3f5",
    "--primary": "#c6a0f6",
    "--primary-foreground": "#24273a",
    "--secondary": "#363a4f",
    "--secondary-foreground": "#cad3f5",
    "--muted": "#1e2030",
    "--muted-foreground": "#a5adcb",
    "--accent": "#363a4f",
    "--accent-foreground": "#cad3f5",
    "--border": "#494d64",
    "--input": "#494d64",
    "--ring": "#c6a0f6",
    "--chart-1": "#c6a0f6",
    "--chart-2": "#8aadf4",
    "--chart-3": "#a6da95",
    "--chart-4": "#f5a97f",
    "--chart-5": "#ed8796",
    "--sidebar": "#1e2030",
    "--sidebar-foreground": "#cad3f5",
    "--sidebar-primary": "#c6a0f6",
    "--sidebar-primary-foreground": "#24273a",
    "--sidebar-accent": "#363a4f",
    "--sidebar-accent-foreground": "#cad3f5",
    "--sidebar-border": "#363a4f",
    "--sidebar-ring": "#c6a0f6"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#939ab7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#cad3f5"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ee99a0"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#ed8796"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#f5a97f"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f5a97f"
      }
    },
    {
      "name": "Symbols",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#ed8796"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#8bd5ca"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#c6a0f6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#91d7e3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a6da95"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f5bde6"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8aadf4"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#f4dbd6"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#eed49f"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#939ab7"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8aadf4"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#eed49f"
      }
    },
    {
      "name": "Property keys",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8aadf4"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#eed49f"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ed8796",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8aadf4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#939ab7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a6da95"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ed8796"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8aadf4"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ed8796"
      }
    }
  ]
}
