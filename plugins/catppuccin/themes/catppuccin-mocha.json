{
  "base": "dark",
  "tokens": {
    "--background": "#1e1e2e",
    "--editor-surface": "#1e1e2e",
    "--foreground": "#cdd6f4",
    "--card": "#181825",
    "--card-foreground": "#cdd6f4",
    "--popover": "#181825",
    "--popover-foreground": "#cdd6f4",
    "--primary": "#cba6f7",
    "--primary-foreground": "#1e1e2e",
    "--secondary": "#313244",
    "--secondary-foreground": "#cdd6f4",
    "--muted": "#181825",
    "--muted-foreground": "#a6adc8",
    "--accent": "#313244",
    "--accent-foreground": "#cdd6f4",
    "--border": "#45475a",
    "--input": "#45475a",
    "--ring": "#cba6f7",
    "--chart-1": "#cba6f7",
    "--chart-2": "#89b4fa",
    "--chart-3": "#a6e3a1",
    "--chart-4": "#fab387",
    "--chart-5": "#f38ba8",
    "--sidebar": "#181825",
    "--sidebar-foreground": "#cdd6f4",
    "--sidebar-primary": "#cba6f7",
    "--sidebar-primary-foreground": "#1e1e2e",
    "--sidebar-accent": "#313244",
    "--sidebar-accent-foreground": "#cdd6f4",
    "--sidebar-border": "#313244",
    "--sidebar-ring": "#cba6f7"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9399b2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#eba0ac"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Symbols",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#f5e0dc"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9399b2"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Property keys",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#89b4fa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9399b2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    }
  ]
}
