{
  "base": "light",
  "tokens": {
    "--background": "#eff1f5",
    "--editor-surface": "#eff1f5",
    "--foreground": "#4c4f69",
    "--card": "#e6e9ef",
    "--card-foreground": "#4c4f69",
    "--popover": "#e6e9ef",
    "--popover-foreground": "#4c4f69",
    "--primary": "#8839ef",
    "--primary-foreground": "#eff1f5",
    "--secondary": "#ccd0da",
    "--secondary-foreground": "#4c4f69",
    "--muted": "#e6e9ef",
    "--muted-foreground": "#5c5f77",
    "--accent": "#ccd0da",
    "--accent-foreground": "#4c4f69",
    "--border": "#bcc0cc",
    "--input": "#bcc0cc",
    "--ring": "#8839ef",
    "--chart-1": "#8839ef",
    "--chart-2": "#1e66f5",
    "--chart-3": "#40a02b",
    "--chart-4": "#fe640b",
    "--chart-5": "#d20f39",
    "--sidebar": "#e6e9ef",
    "--sidebar-foreground": "#4c4f69",
    "--sidebar-primary": "#8839ef",
    "--sidebar-primary-foreground": "#eff1f5",
    "--sidebar-accent": "#ccd0da",
    "--sidebar-accent-foreground": "#4c4f69",
    "--sidebar-border": "#ccd0da",
    "--sidebar-ring": "#8839ef"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7c7f93",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e64553"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#f05700"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f05700"
      }
    },
    {
      "name": "Symbols",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#179299"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#0092d1"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#3d9d28"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d260b5"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#c47463"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#c77700"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7c7f93"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c77700"
      }
    },
    {
      "name": "Property keys",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#c77700"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d20f39",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1e66f5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7c7f93",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3d9d28"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    }
  ]
}
