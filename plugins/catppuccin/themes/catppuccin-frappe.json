{
  "base": "dark",
  "tokens": {
    "--background": "#303446",
    "--editor-surface": "#303446",
    "--foreground": "#c6d0f5",
    "--card": "#292c3c",
    "--card-foreground": "#c6d0f5",
    "--popover": "#292c3c",
    "--popover-foreground": "#c6d0f5",
    "--primary": "#ca9ee6",
    "--primary-foreground": "#303446",
    "--secondary": "#414559",
    "--secondary-foreground": "#c6d0f5",
    "--muted": "#292c3c",
    "--muted-foreground": "#a5adce",
    "--accent": "#414559",
    "--accent-foreground": "#c6d0f5",
    "--border": "#51576d",
    "--input": "#51576d",
    "--ring": "#ca9ee6",
    "--chart-1": "#ca9ee6",
    "--chart-2": "#8caaee",
    "--chart-3": "#a6d189",
    "--chart-4": "#ef9f76",
    "--chart-5": "#e78284",
    "--sidebar": "#292c3c",
    "--sidebar-foreground": "#c6d0f5",
    "--sidebar-primary": "#ca9ee6",
    "--sidebar-primary-foreground": "#303446",
    "--sidebar-accent": "#414559",
    "--sidebar-accent-foreground": "#c6d0f5",
    "--sidebar-border": "#414559",
    "--sidebar-ring": "#ca9ee6"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#949cbb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#c6d0f5"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ea999c"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#e78284"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ef9f76"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ef9f76"
      }
    },
    {
      "name": "Symbols",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#e78284"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#81c8be"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#99d1db"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a6d189"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f4b8e4"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8caaee"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#f2d5cf"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#e5c890"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#949cbb"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8caaee"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e5c890"
      }
    },
    {
      "name": "Property keys",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8caaee"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#e5c890"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e78284",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8caaee",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#949cbb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a6d189"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e78284"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8caaee"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#e78284"
      }
    }
  ]
}
