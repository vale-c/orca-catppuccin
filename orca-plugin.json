{
  "manifestVersion": 2,
  "id": "catppuccin",
  "publisher": "vale-c",
  "name": "Catppuccin for Orca",
  "version": "1.0.1",
  "execution": "data",
  "description": "Soothing pastel app and terminal themes in all four Catppuccin flavors, with matching syntax colors.",
  "license": "MIT",
  "repository": "https://github.com/vale-c/orca-catppuccin",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "catppuccin-latte",
        "title": "Catppuccin Latte",
        "path": "themes/catppuccin-latte.json"
      },
      {
        "id": "catppuccin-frappe",
        "title": "Catppuccin Frappé",
        "path": "themes/catppuccin-frappe.json"
      },
      {
        "id": "catppuccin-macchiato",
        "title": "Catppuccin Macchiato",
        "path": "themes/catppuccin-macchiato.json"
      },
      {
        "id": "catppuccin-mocha",
        "title": "Catppuccin Mocha",
        "path": "themes/catppuccin-mocha.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "catppuccin-latte",
        "title": "Catppuccin Latte",
        "path": "terminal/catppuccin-latte.json"
      },
      {
        "id": "catppuccin-frappe",
        "title": "Catppuccin Frappé",
        "path": "terminal/catppuccin-frappe.json"
      },
      {
        "id": "catppuccin-macchiato",
        "title": "Catppuccin Macchiato",
        "path": "terminal/catppuccin-macchiato.json"
      },
      {
        "id": "catppuccin-mocha",
        "title": "Catppuccin Mocha",
        "path": "terminal/catppuccin-mocha.json"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "Orca in the four Catppuccin flavors, Latte, Frappé, Macchiato and Mocha, each showing the sidebar and syntax-highlighted TypeScript"
  }
}
